# Application Environment
NODE_ENV=development
PORT=5000

# Database
# If left blank or MongoDB is unavailable locally, the application automatically boots an embedded in-memory MongoDB store for seamless local zero-config evaluation.
MONGODB_URI=mongodb://localhost:27017/migration_workbench

# AI / LLM Configuration
# Optional: Provide your Gemini or OpenAI API Key. If empty or unavailable, the deterministic fallback provider activates seamlessly.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=

# Security & CORS
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
